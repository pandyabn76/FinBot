{
  "entities": {
    "Source": {
      "title": "Source",
      "description": "A financial news source (RSS feed or website)",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the source" },
        "url": { "type": "string", "description": "RSS feed URL or website URL" },
        "category": { "type": "string", "enum": ["stocks", "currency", "commodity", "indices", "crypto"], "description": "Market niche" },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Relevant tags for this source" },
        "lastFetched": { "type": "string", "format": "date-time", "description": "Last time this source was fetched" }
      },
      "required": ["name", "url", "category"]
    },
    "WatchlistItem": {
      "title": "WatchlistItem",
      "description": "A symbol or asset the user is watching",
      "type": "object",
      "properties": {
        "symbol": { "type": "string", "description": "Ticker symbol or asset name" },
        "category": { "type": "string", "description": "Asset class" },
        "uid": { "type": "string", "description": "User ID who added this" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When it was added" }
      },
      "required": ["symbol", "category", "uid"]
    },
    "Article": {
      "title": "Article",
      "description": "A news article fetched from a source",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Article title" },
        "link": { "type": "string", "description": "Article URL" },
        "content": { "type": "string", "description": "Article content or snippet" },
        "pubDate": { "type": "string", "format": "date-time", "description": "Publication date" },
        "sourceId": { "type": "string", "description": "ID of the source" },
        "category": { "type": "string", "description": "Market niche" }
      },
      "required": ["title", "link", "sourceId", "category"]
    },
    "Summary": {
      "title": "Summary",
      "description": "A daily market analysis summary generated by Gemini",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date", "description": "Date of the summary" },
        "content": { "type": "string", "description": "Markdown content of the summary" },
        "categories": { "type": "array", "items": { "type": "string" }, "description": "Categories included in this summary" }
      },
      "required": ["date", "content"]
    },
    "ThematicReport": {
      "title": "ThematicReport",
      "description": "An in-depth thematic research report generated by Gemini",
      "type": "object",
      "properties": {
        "theme": { "type": "string", "description": "The research theme" },
        "content": { "type": "string", "description": "Markdown content of the report" },
        "date": { "type": "string", "format": "date-time", "description": "Generation date" },
        "uid": { "type": "string", "description": "User ID who generated this" }
      },
      "required": ["theme", "content", "date", "uid"]
    }
  },
  "firestore": {
    "sources": { "schema": "Source", "description": "List of financial news sources" },
    "articles": { "schema": "Article", "description": "Aggregated news articles" },
    "summaries": { "schema": "Summary", "description": "Daily market summaries" },
    "watchlist": { "schema": "WatchlistItem", "description": "User watchlist of symbols" },
    "thematic_reports": { "schema": "ThematicReport", "description": "User-generated thematic research reports" }
  }
}
